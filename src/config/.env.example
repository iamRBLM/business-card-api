# Server & App Environment
PORT=8080
NODE_ENV=development
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

# Authentication (Minimum 32 characters required by jose)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_12345

# Database - Local MongoDB (Default)
DB_CONNECTION_STRING=mongodb://localhost:27017/biz_cards_dev

# Database - MongoDB Atlas (Alternative)
# DB_CONNECTION_STRING=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/biz_cards_dev