{
  "name": "biz-cards-api",
  "version": "1.0.0",
  "description": "Business Card Management REST API",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "dotenvx run -f src/config/.env.development -f src/config/.env -- nodemon --exec tsx src/index.ts | pino-pretty --singleLine",
    "prod": "dotenvx run -f src/config/.env.production -f src/config/.env -- tsx src/index.ts",
    "test": "dotenvx run -f src/config/.env.test -f src/config/.env -- tsx src/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.19.1",
    "bcrypt": "^6.0.0",
    "chalk": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jose": "^6.2.8",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.1",
    "morgan": "^1.11.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.1",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
